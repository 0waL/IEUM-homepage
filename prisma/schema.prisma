generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("member") // admin | member
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts            Post[]
  inquiryComments  InquiryComment[]
}


model Post {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String
  content     String
  category    String   @default("활동") // 활동 | 프로젝트 | 공지
  coverImage  String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  tags PostTag[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

model Member {
  id        String   @id @default(cuid())
  name      String
  role      String   // 예: 회장, 부회장, 개발팀장, 디자인팀장, 부원
  bio       String?
  github    String?
  instagram String?
  email     String?
  image     String?
  generation Int     @default(0) // 기수 (0=창립, 1기, 2기...)
  order     Int      @default(0) // 표시 순서
  active    Boolean  @default(true) // 현재 활동 멤버 여부
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FAQ {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Inquiry {
  id        String   @id @default(cuid())
  title     String
  content   String
  author    String   // 작성자 이름
  email     String?  // 연락용 이메일 (선택)
  status    String   @default("pending") // pending | answered
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  InquiryComment[]
}

model InquiryComment {
  id        String   @id @default(cuid())
  content   String
  inquiryId String
  inquiry   Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  authorId  String
  user      User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
}

model InviteToken {
  id        String    @id @default(cuid())
  token     String    @unique
  used      Boolean   @default(false)
  usedBy    String?   // 사용한 유저 id
  createdBy String    // 발급한 관리자 id
  note      String?   // 메모
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}
